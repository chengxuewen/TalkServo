# TalkServo sample config (modules/06 §config) — copy to .env, no secrets here.
# TS_JWT_SECRET is REQUIRED (fail-fast at startup): openssl rand -base64 48
TS_JWT_SECRET=change-me

TS_JWT_TTL_S=3600
TURN_TTL_S=3600
# dispatch cap on floor-hold; `off` for open mode
FLOOR_MAX_HOLD_MS=45000
FLOOR_MEDIA_GRACE_MS=2000
FLOOR_REQUEST_COOLDOWN_MS=500
HEARTBEAT_S=30
RTC_PORT_MIN=40000
RTC_PORT_MAX=40100
TRANSPORT_GUARDRAIL=50
NO_RTP_WATCHDOG_MS=2000
ROOM_IDLE_TTL_S=600
MAX_PEERS=10
MAX_QUEUE=8
MAX_FRAME_BYTES=65536

# bind address
# TURN (optional — unset keeps Welcome creds empty for dev without coturn)
# TURN_SECRET stays physically separate from TS_JWT_SECRET (independent rotation)
TURN_SECRET=
TURN_URI=turn:127.0.0.1:3478?transport=udp

# bind address (LAN: keep 0.0.0.0 + set TS_ANNOUNCED_IP)
# admin console (plan-5, D18) — MUST differ from TS_JWT_SECRET (startup
# refuses equal values). Unset/empty => /admin/api answers 503 (fail-closed).
TS_ADMIN_SECRET=
# Scheme-inclusive public base for issued join links. REQUIRED for LAN/TLS
# deployments (Caddy): unset falls back to the Host header with http://,
# which is loopback-dev only (getUserMedia needs secure context on LAN IPs).
TS_PUBLIC_BASE=

TS_BIND=0.0.0.0:8080
# ICE announced address (mediasoup bind posture, PIT-7):
#   unset -> dev/e2e loopback: transports bind 127.0.0.1 directly
#   set   -> LAN/deploy: bind 0.0.0.0 + announce this routable IP,
#            e.g. TS_ANNOUNCED_IP=192.168.2.127 (D17 LAN range)
TS_ANNOUNCED_IP=
# mask-aligned RTC range for the #8 single-leg impairment
# (scripts/netem.sh media matches UDP src port 40960-41215):
#   RTC_PORT_MIN=40960
#   RTC_PORT_MAX=41215
